# nginx 主配置文件
# D:\nginx-1.28.1\conf\nginx.conf

worker_processes  1;  # 工作进程数，根据CPU核心数调整

events {
    worker_connections  1024;  # 每个工作进程的最大连接数
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    
    # 主页 - 代理到 Flask 应用
    server {
        # 监听端口和服务器名
        listen 8001;                  # 监听80端口
        listen [::]:8001;            # 监听IPv6的80端口
        server_name 127.0.0.1;  # 服务器域名

        # 反向代理配置
        location / {
            proxy_pass http://127.0.0.1:5000;  # 转发到Flask应用
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
    
    # 文档1 - 静态文件服务
    server {
        # 监听端口和服务器名
        listen 8080;                  # 监听8080端口
        listen [::]:8080;            # 监听IPv6的8080端口
        server_name 127.0.0.1;  # 服务器域名
        
        # Windows路径需要使用反斜杠，或使用正斜杠但需要正确转义
        location / {
            root  D:/PyProjects/proteinx_web/build/nginx_static/document/01_dl;
            index index.html;
        }

        location /api/ {
            # 代理到5000端口的API
            proxy_pass http://localhost:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}